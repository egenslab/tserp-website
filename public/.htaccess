# Apache: serve /features/flights from features/flights.html
Options -MultiViews
RewriteEngine On

# One address for search engines: travelsuiteerp.com -> https://www.travelsuiteerp.com (same path)
RewriteCond %{HTTP_HOST} ^travelsuiteerp\.com$ [NC]
RewriteRule ^(.*)$ https://www.travelsuiteerp.com/$1 [R=301,L]

# Old travelsuiteerp.com addresses -> new pages (keeps search rankings)
RewriteRule ^flight-management-software/?$ /features/flights [R=301,L]
RewriteRule ^success-stories/.+$ /success-stories [R=301,L]
RewriteRule ^blog/b2b-agent-credit-limits/?$ /blog/b2b-agent-commission-payouts [R=301,L]
RewriteRule ^blog/double-entry-accounting-travel/?$ /blog/travel-agency-profit-and-loss [R=301,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]
ErrorDocument 404 /404.html
